# Where you are deploying Mediateca. Copy this file to `.kamal/deploy.env` and
# fill it in:
#
#     cp .kamal/deploy.env.example .kamal/deploy.env
#
# `.kamal/deploy.env` is gitignored. This example isn't — it holds no secret,
# only the shape of the answers. `bin/kamal` reads the real file and puts these
# into the environment, where config/deploy.yml picks them up.
#
# The three without a default have none on purpose: a deploy that guessed the
# host would SSH into whatever machine answers at that address on your network,
# and one that guessed the music directory would mount the wrong disk.

# The machine. An address on your LAN, or a name it answers to.
MEDIATECA_HOST=192.168.1.10

# Who you are on it over SSH. Must be in the `docker` group, and must be able to
# read the music. (Kamal can install Docker itself, but only as root; most NAS
# boxes deny root over SSH, so it is usually installed by hand — see the README.)
MEDIATECA_SSH_USER=you

# The trust boundary. No request may name a file outside this directory, and it
# is bind-mounted read-only into the container under this same path.
MEDIATECA_MEDIA_ROOT=/mnt/data/multimedia

# Where the scan goes looking for music. Defaults to the media root; set it when
# the same disk also holds things that are not music.
MEDIATECA_MUSIC_ROOT=/mnt/data/multimedia/Music

# A beets database, if you keep one. It is read-only, and optional: the disk
# decides what music exists, beets only says what it is called. Leave it empty
# and the library is still the library.
MEDIATECA_BEETS_DATABASE=

# The image registry. Defaults to <host>:5555 — a plain-HTTP registry running on
# the server itself, so the image never leaves the house.
# MEDIATECA_REGISTRY=192.168.1.10:5555

# What to call the image, and what the server's CPU is.
# MEDIATECA_IMAGE=mediateca
# MEDIATECA_ARCH=amd64
