<% content_for :title, "#{@album.title} — #{@album.artist.name}" %>
<% content_for :dressing, @album.palette.to_style %>
<% length = album_length(@album.tracks.sum { |track| track.duration.to_f }) %>

<%# The sleeve stands behind its own record, blown up and blurred, and the colour
    the app read off it lights the header from above. Both of those are the record
    you are LOOKING AT — which is not what the #backdrop underneath the whole
    building is about, and not what the Play button is painted in. That is the
    record that is PLAYING, and it keeps its colour while you browse: what you
    open dresses its own header, and nothing else in the app changes hands. %>
<%# @container, not a breakpoint: the title's room depends on the sidebar and the
    queue, not on the window. At iPad width with the rail open, `sm:text-7xl` fired
    on the viewport while the column it had to fit in was 186px wide — and the
    record's name, the one thing the page is about, got cut in half. Sized against
    the container, it fits whatever column it lands in. %>
<header class="@container relative">
  <%= render "shared/hero_wash", picture: (cover_url(@album) if @album.cover_path.present?) %>

  <div class="relative px-4 pb-10 pt-12 sm:px-8 sm:pt-24">
    <div class="flex flex-col gap-6 @2xl:flex-row @2xl:items-end @2xl:gap-8">
      <%# The one image on the page anybody came to see: it is not lazy-loaded. %>
      <%= render "shared/sleeve", album: @album, loading: "eager",
                 class: "size-44 shrink-0 rounded-xl object-cover shadow-2xl shadow-black/60 ring-1 ring-white/10 @2xl:size-60" %>

      <div class="min-w-0 pb-2">
        <%# What kind of record this is, in its own colour: an EP is not an album,
            and a compilation is neither. The file says which, when it knows. %>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">
          <%= @album.album_type.presence || "Album" %>
        </p>
        <h1 class="mt-3 text-[clamp(1.75rem,7cqi,4.5rem)] font-bold leading-[1.05] tracking-tight text-balance break-words hyphens-auto text-white drop-shadow-lg"><%= @album.title %></h1>
        <p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-neutral-200">
          <%= link_to @album.artist.name, artist_path(@album.artist), class: "font-semibold text-white hover:underline" %>
          <span aria-hidden="true" class="text-neutral-500">•</span>
          <% if @album.year %>
            <span><%= @album.year %></span>
            <span aria-hidden="true" class="text-neutral-500">•</span>
          <% end %>
          <span><%= pluralize(@album.tracks.size, "song") %><%= ", #{length}" if length %></span>

          <%# What the whole record is, as files — when the whole record is one
              thing. The rows still say it song by song; this answers the question
              without making anybody read twenty of them. %>
          <% if @album.quality %>
            <span class="ml-1 inline-flex shrink-0 items-center whitespace-nowrap rounded bg-white/15 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white ring-1 ring-inset ring-white/20">
              <%= @album.quality %>
            </span>
          <% end %>
        </p>
      </div>
    </div>
  </div>
</header>

<div class="px-4 pb-10 sm:px-8">
  <div class="mb-6 flex items-center gap-3">
    <%# The songs are already on the screen, so the queue is simply the rows. %>
    <%= render "shared/put_on", label: @album.title,
               play: { action: "player#play", player_index_param: 0 },
               shuffle: { action: "player#playShuffled", player_index_param: 0 } %>

    <%= render "shared/heart", thing: @album, size: "large" %>
  </div>

  <%# The index has to be the whole queue's, not the disc's: on a two-disc
      album, the first track of the second disc is not queue position 1. %>
  <% @album.tracks.each_with_index.group_by { |track, _| track.disc_no }.each do |disc_no, numbered_tracks| %>
    <% if @album.disc_total > 1 %>
      <h2 class="mb-2 mt-8 px-2 text-xs sm:px-4 font-semibold uppercase tracking-widest text-neutral-500">
        Disc <%= disc_no %>
      </h2>
    <% end %>

    <div class="grid grid-cols-[2rem_1fr_auto] items-center gap-4 border-b border-white/10 px-2 pb-2 text-xs text-neutral-300 sm:px-4">
      <span class="text-right">#</span>
      <span>Title</span>
    </div>

    <ol class="mt-1 divide-y divide-white/5">
      <% numbered_tracks.each do |track, position| %>
        <li class="flex items-center gap-1">
          <button type="button" <%= tag.attributes(data: playable(track, position)) %>
                  aria-current="false"
                  class="group grid min-w-0 flex-1 grid-cols-[2rem_1fr_auto] items-center gap-4 rounded-lg px-4 py-1.5 text-left transition hover:bg-white/10 aria-[current=true]:text-accent">
            <span class="relative flex justify-end">
              <span class="text-sm tabular-nums text-neutral-300 group-hover:invisible group-aria-[current=true]:invisible">
                <%= track.track_no %>
              </span>
              <%# The one playing shows a bouncing equalizer instead of its number. %>
              <span aria-hidden="true" class="absolute inset-y-0 right-0 hidden items-center text-accent group-aria-[current=true]:flex">
                <span class="eq"><i></i><i></i><i></i><i></i></span>
              </span>
              <span aria-hidden="true" class="absolute inset-y-0 right-0 hidden items-center text-white group-hover:flex group-aria-[current=true]:hidden">
                <svg class="size-3.5" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M3 1.713a.7.7 0 0 1 1.05-.607l10.89 6.288a.7.7 0 0 1 0 1.212L4.05 14.894A.7.7 0 0 1 3 14.288V1.713Z"/>
                </svg>
              </span>
            </span>

            <span class="min-w-0">
              <span class="block truncate text-sm font-medium text-neutral-100 group-aria-[current=true]:text-accent">
                <%= track.title %>
              </span>
              <%# The record already says whose it is, so a song only names its
                  artist when the file credits it to somebody else: a guest, a
                  duet, a compilation. %>
              <% if track.artist.present? %>
                <span class="block truncate text-xs text-neutral-400"><%= track.artist_name %></span>
              <% end %>
            </span>

            <span class="flex items-center justify-end gap-3">
              <%# How the file is encoded, said as briefly as it can be said: a
                  lossless track wears its format and nothing else, a compressed
                  one adds the bits it was given and an icon for how it spent
                  them. Every measure we have is on hover. %>
              <% audio = track.audio %>
              <% if audio.known? %>
                <span title="<%= audio.detail %>"
                      class="hidden shrink-0 items-center gap-1 whitespace-nowrap rounded bg-neutral-800 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-neutral-300 ring-1 ring-inset ring-white/10 sm:inline-flex"><%= audio.quality %><%= render "shared/bit_rate_mode", mode: audio.bit_rate_mode %></span>
              <% end %>
              <span class="text-sm tabular-nums text-neutral-300"><%= track_duration(track.duration) %></span>
            </span>
          </button>

          <%= render "shared/heart", thing: track %>
          <%= render "shared/add_to_playlist", track: track %>
        </li>
      <% end %>
    </ol>
  <% end %>
</div>
