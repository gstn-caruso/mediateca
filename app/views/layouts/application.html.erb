<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Mediateca" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mediateca">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# The player controller sits on <body> so that play buttons anywhere on the
      page fall inside its scope. What it drives — the <audio> element and the
      now-playing strip — lives in the permanent #player below, and survives the
      body swap Turbo Drive does on navigation. %>
  <body class="h-full overflow-hidden bg-ambient text-neutral-200 antialiased"
        data-controller="player" data-player-profile-value="<%= Current.profile&.id %>">
    <%# With nobody listening the picker owns the screen: no sidebar, no player.
        So leaving a profile stops the music, which is what leaving means. %>
    <% if Current.profile %>
      <%# The library rail and its topbar toggle both live in here, so one
          sidebar controller can reach both. %>
      <div class="relative h-full" data-controller="sidebar">
        <%# The album, and everything you browse, is the base layer: edge to edge,
            scrolling under the glass that floats over it. Its padding keeps the
            reading clear of the chrome, and gives way when a rail folds. %>
        <main data-sidebar-target="content" data-player-target="content"
              class="absolute inset-0 overflow-y-auto pb-24 pt-20 transition-[padding] duration-200 md:pl-80 md:pr-6">
          <%= yield %>
        </main>

        <%= render "shared/header" %>
        <%= render "shared/sidebar" %>
        <%= render "shared/queue" %>

        <%# The player floats free of the edges: a centred pill, a touch up from
            the bottom, the way Apple Music's mini-player sits. %>
        <div id="player" data-turbo-permanent
             class="absolute bottom-3 left-1/2 z-40 -translate-x-1/2 rounded-2xl glass">
          <%= render "shared/player" %>
        </div>
      </div>
    <% else %>
      <main class="h-full overflow-y-auto"><%= yield %></main>
    <% end %>
  </body>
</html>
