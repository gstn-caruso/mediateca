<% content_for :title, @artist.name %>

<header class="bg-gradient-to-b from-emerald-900/40 to-transparent px-4 pb-8 pt-8 sm:px-8 sm:pt-16">
  <p class="text-xs font-semibold uppercase tracking-widest text-neutral-300">Artist</p>
  <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-white sm:text-6xl"><%= @artist.name %></h1>
  <p class="mt-4 text-sm text-neutral-300">
    <%= pluralize(@albums.size, "album") %>
  </p>
</header>

<div class="px-4 pb-8 sm:px-8">
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
    <% @albums.each do |album| %>
      <%= link_to album_path(album), class: "group rounded-lg bg-neutral-900/60 p-4 transition hover:bg-neutral-800" do %>
        <div class="aspect-square overflow-hidden rounded bg-neutral-800 shadow-xl">
          <%= image_tag cover_album_path(album), alt: "", loading: "lazy",
                        class: "size-full object-cover transition duration-300 group-hover:scale-105" %>
        </div>
        <p class="mt-4 truncate text-sm font-semibold text-white"><%= album.title %></p>
        <p class="mt-1 truncate text-xs text-neutral-400">
          <%= album.year %><%= " · #{album.album_type}" if album.album_type.present? %>
        </p>
      <% end %>
    <% end %>
  </div>
</div>
