<% content_for :title, @artist.name %>

<h1 class="mb-8 text-3xl font-bold tracking-tight"><%= @artist.name %></h1>

<div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
  <% @albums.each do |album| %>
    <%= link_to album_path(album), class: "group rounded-lg p-4 transition hover:bg-white/5" do %>
      <div class="aspect-square overflow-hidden rounded bg-neutral-800 shadow-lg">
        <%= image_tag cover_album_path(album), alt: "", loading: "lazy",
                      class: "size-full object-cover transition group-hover:scale-105" %>
      </div>
      <p class="mt-4 truncate text-sm font-medium"><%= album.title %></p>
      <p class="mt-1 text-xs text-neutral-500"><%= album.year %></p>
    <% end %>
  <% end %>
</div>
