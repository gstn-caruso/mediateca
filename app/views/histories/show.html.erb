<% content_for :title, "History" %>

<div class="px-4 pb-10 pt-10 sm:px-8 sm:pt-16">
  <header>
    <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">History</h1>
    <p class="mt-3 text-sm text-neutral-400">
      Everything you have listened to, in the order you listened to it —
      <%= link_to "and what it adds up to", statistics_path, class: "font-semibold text-white hover:underline" %>.
    </p>
  </header>

  <% if @history.empty? %>
    <p class="py-16 text-center text-sm text-neutral-500">
      Nothing yet. Put a record on, or bring your Last.fm home.
    </p>
  <% else %>
    <%# A day at a time. Grouped in Ruby, off the rows already in hand — the page
        is a hundred of them, and one more query per day would be a query per
        heading. %>
    <% @history.group_by { |play| play.played_at.to_date }.each do |day, songs| %>
      <section data-history-day class="mt-10 first:mt-8">
        <%# The day rides at the top of its own songs while they scroll under it, so
            it has to hide them. It was a translucent bar blurring whatever passed
            beneath — which is to say it re-blurred the list on every frame of a
            scroll through a year of listening. It is the colour of the page it sits
            on instead, and hides a row by being in front of it. %>
        <h2 class="sticky top-0 z-10 -mx-2 bg-surface px-2 py-2 text-xs font-semibold uppercase tracking-widest text-neutral-500">
          <%= day == Date.current ? "Today" : (day == Date.yesterday ? "Yesterday" : l(day, format: :long)) %>
        </h2>

        <ol class="mt-1">
          <% songs.each do |play| %>
            <li data-history-song class="flex items-center gap-4 rounded-lg px-2 py-2 transition hover:bg-white/5">
              <span class="w-12 shrink-0 text-right text-xs tabular-nums text-neutral-500">
                <%= l(play.played_at.in_time_zone, format: :short).split.last %>
              </span>

              <%# A song you own is a song you can go to. A gap is a name and
                  nothing else: no sleeve, nowhere to click, drawn dim — it is not
                  a lesser listen, it is a listen we have no record of. %>
              <span class="min-w-0 flex-1">
                <% if play.ours? %>
                  <%= link_to album_path(play.track.album), class: "block min-w-0" do %>
                    <span class="block truncate text-sm font-medium text-neutral-100"><%= play.track.title %></span>
                    <span class="block truncate text-xs text-neutral-400"><%= play.track.artist_name %></span>
                  <% end %>
                <% else %>
                  <span class="block truncate text-sm font-medium text-neutral-500"><%= play.title %></span>
                  <span class="block truncate text-xs text-neutral-600"><%= play.artist_name %></span>
                <% end %>
              </span>

              <%# Where the listen came from. What happened here says nothing —
                  this is a Mediateca, and here is where you would expect to be. It
                  is the listening that happened somewhere else that is worth a word. %>
              <% unless play.source == Play::HERE %>
                <span class="shrink-0 rounded bg-white/5 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-neutral-600">
                  Last.fm
                </span>
              <% end %>

              <% unless play.ours? %>
                <span title="You don't have this one"
                      class="shrink-0 text-[10px] font-semibold uppercase tracking-wide text-neutral-700">Not here</span>
              <% end %>
            </li>
          <% end %>
        </ol>
      </section>
    <% end %>

    <%# Paged by the clock, not by an offset: the next page starts where this one
        left off, and the database never counts past what it is not going to show. %>
    <% if @more %>
      <div class="mt-10 text-center">
        <%= link_to "Further back", history_path(before: @history.last.played_at.to_i),
                    class: "inline-block rounded-full bg-white/10 px-6 py-2.5 text-sm font-semibold text-white
                            ring-1 ring-inset ring-white/15 transition hover:bg-white/15" %>
      </div>
    <% end %>
  <% end %>
</div>
