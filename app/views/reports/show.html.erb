<% content_for :title, "Your listening" %>

<% if !@report.any? %>
  <div class="px-4 py-24 text-center sm:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-white">Nothing to report yet</h1>
    <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-neutral-500">
      Put a record on, or bring your Last.fm home — it has been keeping this the whole time.
    </p>
    <%= link_to "Connect Last.fm", scrobbler_path,
                class: "mt-6 inline-block rounded-full bg-accent gel px-5 py-2.5 text-sm font-semibold text-on-accent" %>
  </div>
<% else %>
  <%
    loudest_year = @report.by_year.values.max.to_f
    loudest_hour = @report.by_hour.values.max.to_f
    loudest_artist = @report.by_artist.first&.plays.to_f
    hour_name = ->(h) { "#{h.to_s.rjust(2, "0")}:00" }
  %>

  <div class="mx-auto max-w-5xl px-4 pb-24 pt-10 sm:px-8 sm:pt-16">

    <%# THE THESIS.
        Not "you played 127,231 songs" — every service says that. The one fact only
        a library can hand you is the other one: how much of what you love is not
        in it. So that is the headline, and it is enormous, and it is stated
        without apology because it is not a failure. It is a map. %>
    <header>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">Your listening</p>

      <h1 class="mt-4 text-[clamp(2.5rem,9vw,6rem)] font-bold leading-[0.92] tracking-tight text-white">
        <%= number_with_delimiter(@report.plays) %> songs,<br>
        <span class="text-neutral-600">and <%= @report.missing_share %>% of them<br>aren't on this disk.</span>
      </h1>

      <p class="mt-8 max-w-xl text-sm leading-relaxed text-neutral-400">
        <% if @report.years.positive? %>
          <%= pluralize(@report.years, "year") %> of listening,
        <% end %>
        <%= number_with_delimiter(@report.artists >= Report::MANY ? "#{Report::MANY}+" : @report.artists) %>
        artists deep. Spotify would have shown you the first number and stopped.
        This is a library, not a shop — it has nothing to sell you, so it can afford to tell you
        what it hasn't got.
      </p>
    </header>

    <%# The proportion, made physical. One bar: what you can put on, and what you
        cannot. Nothing else on this page needs to be a chart. %>
    <div class="mt-12">
      <div class="flex h-3 overflow-hidden rounded-full bg-white/5 ring-1 ring-inset ring-white/10">
        <div class="bg-accent" style="width: <%= 100 - @report.missing_share %>%"></div>
      </div>
      <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs">
        <span class="flex items-center gap-2 text-neutral-300">
          <span class="size-2 rounded-full bg-accent"></span>
          <%= number_with_delimiter(@report.ours) %> you can put on
        </span>
        <span class="flex items-center gap-2 text-neutral-500">
          <span class="size-2 rounded-full bg-white/15"></span>
          <%= number_with_delimiter(@report.elsewhere) %> you can't
        </span>
      </div>
    </div>

    <%# THE YEARS. The shape of a life: the year you found something, the year you
        were busy, the year you came back. %>
    <section class="mt-20">
      <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Your years</h2>
      <p class="mt-2 text-sm text-neutral-500">Every song you played, by the year you played it.</p>

      <div class="mt-8 -mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
        <ol class="flex h-52 min-w-max items-end gap-1.5">
          <% @report.by_year.each do |year, count| %>
            <li class="flex w-12 shrink-0 flex-col items-center gap-2" style="height: 100%">
              <div class="flex w-full flex-1 items-end">
                <div title="<%= number_with_delimiter(count) %> in <%= year %>"
                     class="w-full rounded-t bg-gradient-to-t from-accent/25 to-accent/70 transition hover:to-accent"
                     style="height: <%= [ (count / loudest_year * 100).round, 3 ].max %>%"></div>
              </div>
              <span class="shrink-0 text-[10px] tabular-nums text-neutral-600"><%= year.to_s.last(2) %></span>
            </li>
          <% end %>
        </ol>
      </div>
    </section>

    <%# THE CLOCK. Everybody has a shape here and almost nobody knows what theirs
        is. Twenty-four bars, midnight at the left, and the hour you are loudest
        lit up. %>
    <section class="mt-20">
      <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Your hours</h2>
      <p class="mt-2 text-sm text-neutral-500">
        You listen most at <span class="font-semibold text-white"><%= hour_name.call(@report.loudest_hour) %></span>.
      </p>

      <ol class="mt-8 flex h-32 items-end gap-[3px] sm:gap-1.5">
        <% @report.by_hour.each do |hour, count| %>
          <li class="group flex h-full flex-1 flex-col justify-end" title="<%= hour_name.call(hour) %> — <%= number_with_delimiter(count) %>">
            <div class="w-full rounded-sm transition <%= hour == @report.loudest_hour ? "bg-accent" : "bg-white/12 group-hover:bg-white/25" %>"
                 style="height: <%= [ (count / loudest_hour * 100).round, 2 ].max %>%"></div>
          </li>
        <% end %>
      </ol>
      <div class="mt-2 flex justify-between text-[10px] tabular-nums text-neutral-600">
        <span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>23:00</span>
      </div>
    </section>

    <%# THE PEOPLE. Owned and not, side by side, which is the only honest way to
        draw a taste — and the hollow ones are most of it. %>
    <section class="mt-20">
      <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Who you listen to</h2>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-neutral-500">
        Everybody, whether or not there is a record of theirs on the disk. The ones in grey are the ones
        there isn't.
      </p>

      <ol class="mt-8 space-y-1.5">
        <% @report.by_artist.each_with_index do |line, at| %>
          <li>
            <% inner = capture do %>
              <span class="w-6 shrink-0 text-right text-xs tabular-nums text-neutral-700"><%= at + 1 %></span>
              <span class="w-32 shrink-0 truncate text-sm font-medium sm:w-44 <%= line.artist ? "text-white" : "text-neutral-500" %>">
                <%= line.name %>
              </span>
              <span class="relative h-2 min-w-0 flex-1 overflow-hidden rounded-full bg-white/5">
                <span class="absolute inset-y-0 left-0 rounded-full <%= line.artist ? "bg-accent" : "bg-white/15" %>"
                      style="width: <%= [ (line.plays / loudest_artist * 100).round, 1 ].max %>%"></span>
              </span>
              <span class="w-14 shrink-0 text-right text-xs tabular-nums text-neutral-500">
                <%= number_with_delimiter(line.plays) %>
              </span>
              <span class="hidden w-20 shrink-0 text-right text-[10px] font-semibold uppercase tracking-wide sm:block
                           <%= line.artist ? "text-neutral-700" : "text-neutral-600" %>">
                <%= line.artist ? "on the disk" : "not here" %>
              </span>
            <% end %>

            <% if line.artist %>
              <%= link_to artist_path(line.artist), class: "flex items-center gap-3 rounded-lg px-2 py-1.5 transition hover:bg-white/5" do %>
                <%= inner %>
              <% end %>
            <% else %>
              <div class="flex items-center gap-3 rounded-lg px-2 py-1.5"><%= inner %></div>
            <% end %>
          </li>
        <% end %>
      </ol>
    </section>

    <%# THE GAP, named. Not a percentage any more: the actual records this house
        should have and does not. It is the section the whole app was built to be
        able to write. %>
    <% if @report.wanted.any? %>
      <section class="mt-20 rounded-3xl bg-gradient-to-b from-white/[0.06] to-transparent p-6 ring-1 ring-inset ring-white/10 sm:p-9">
        <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">What isn't here yet</h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-400">
          You have played these <strong class="font-semibold text-white"><%= number_with_delimiter(@report.elsewhere) %></strong>
          times between them, and there is not one record by any of them on this disk. Nothing is broken —
          this is just the shape of the distance between what you listen to and what you own. It is also,
          if you want it, a shopping list.
        </p>

        <div class="mt-8 grid gap-10 lg:grid-cols-2">
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-500">The artists</h3>
            <ol class="mt-4 space-y-1">
              <% @report.wanted.first(12).each_with_index do |line, at| %>
                <li class="flex items-baseline gap-3 rounded-lg px-2 py-1.5">
                  <span class="w-5 shrink-0 text-right text-xs tabular-nums text-neutral-700"><%= at + 1 %></span>
                  <span class="min-w-0 flex-1 truncate text-sm text-neutral-300"><%= line.name %></span>
                  <span class="shrink-0 text-xs tabular-nums text-neutral-600"><%= number_with_delimiter(line.plays) %></span>
                </li>
              <% end %>
            </ol>
          </div>

          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-500">The songs</h3>
            <ol class="mt-4 space-y-1">
              <% @report.wanted_songs.first(12).each_with_index do |line, at| %>
                <li class="flex items-center gap-3 rounded-lg px-2 py-1.5">
                  <span class="w-5 shrink-0 text-right text-xs tabular-nums text-neutral-700"><%= at + 1 %></span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-sm text-neutral-300"><%= line.name %></span>
                    <span class="block truncate text-xs text-neutral-600"><%= line.under %></span>
                  </span>
                  <span class="shrink-0 text-xs tabular-nums text-neutral-600"><%= number_with_delimiter(line.plays) %></span>
                </li>
              <% end %>
            </ol>
          </div>
        </div>
      </section>
    <% end %>

    <%# What you *do* have, worn out. %>
    <% if @report.worn_out.any? %>
      <section class="mt-20">
        <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Records you've worn out</h2>
        <p class="mt-2 text-sm text-neutral-500">These ones are here, and you have not spared them.</p>

        <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          <% @report.worn_out.first(8).each do |line| %>
            <%= link_to album_path(line.artist), class: "group rounded-lg p-3 transition hover:bg-white/5" do %>
              <div class="aspect-square overflow-hidden rounded bg-neutral-900 shadow-lg">
                <%= image_tag cover_url(line.artist), alt: "", loading: "lazy",
                              class: "size-full object-cover transition duration-300 group-hover:scale-105" %>
              </div>
              <p class="mt-3 truncate text-sm font-semibold text-white"><%= line.name %></p>
              <p class="truncate text-xs text-neutral-500"><%= line.under %></p>
              <p class="mt-1 text-xs tabular-nums text-accent"><%= pluralize(line.plays, "play") %></p>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# THE LISTS. Made from the history, which is why no shop could make them: two
        of the three point at things it could not sell you. %>
    <section class="mt-20 rounded-3xl bg-white/[0.04] p-6 ring-1 ring-inset ring-white/10 sm:p-9">
      <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Three lists you're owed</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-400">
        Made out of the history rather than the disk — which is what makes them worth having. Two of them
        point at music nobody could sell you: one at what you already own and have forgotten, one at what
        you play constantly and have never had a copy of.
      </p>

      <dl class="mt-8 grid gap-4 sm:grid-cols-3">
        <% {
             "On repeat" => "The songs on this disk you play most. The only one of these any music app could have made.",
             "Not on the disk" => "What you play most and cannot play here. It is a playlist that plays nothing, and it is exactly what to go and find.",
             "You've forgotten these" => "Songs you own, played hard once, and haven't gone back to in a year."
           }.each do |name, why| %>
          <div class="rounded-2xl bg-black/30 p-4 ring-1 ring-inset ring-white/5">
            <dt class="text-sm font-semibold text-white"><%= name %></dt>
            <dd class="mt-2 text-xs leading-relaxed text-neutral-500"><%= why %></dd>
          </div>
        <% end %>
      </dl>

      <%= button_to "Make them", report_path, method: :post,
                    class: "mt-7 cursor-pointer rounded-full bg-accent gel px-6 py-3 text-sm font-semibold
                            text-on-accent transition hover:scale-105 hover:bg-accent-bright" %>
      <p class="mt-3 text-xs text-neutral-600">
        They are rebuilt every time, not added to — an answer that keeps yesterday's songs in it is a stale
        answer wearing a fresh name.
      </p>
    </section>
  </div>
<% end %>
