<%# Like the whole record in one press — the album's counterpart to a track's
    heart, said in words. Same toggle: filled and lit once it's a favourite,
    outlined when it isn't. %>
<% liked = Current.profile.likes?(album) %>
<%= button_to [ album, :like ],
              method: liked ? :delete : :post,
              "aria-label": "#{liked ? "Unlike" : "Like"} #{album.title}",
              class: "inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold uppercase tracking-wide transition
                      #{liked ? "bg-accent/20 text-accent ring-1 ring-inset ring-accent/40 hover:bg-accent/30" : "text-white ring-1 ring-inset ring-white/25 hover:bg-white/10"}" do %>
  <svg class="size-4 shrink-0" viewBox="0 0 16 16" fill="<%= liked ? "currentColor" : "none" %>"
       stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M8 14S1.5 9.7 1.5 5.6A3.6 3.6 0 0 1 8 3.5a3.6 3.6 0 0 1 6.5 2.1C14.5 9.7 8 14 8 14Z"/>
  </svg>
  Me gusta todo el disco
<% end %>
