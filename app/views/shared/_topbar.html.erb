<%# Sticky, because a search bar you have to scroll up to reach is a search bar
    you stop using. %>
<div class="sticky top-0 z-10 flex items-center gap-2 bg-neutral-900/80 px-4 py-3 backdrop-blur sm:px-8">
  <%# The sidebar is desktop-only, and it holds the library, the hearts and the
      way out of a profile. On a phone all three have to live here. %>
  <div class="flex shrink-0 items-center gap-1 md:hidden">
    <%= link_to root_path, "aria-label": "Your Library",
                class: "rounded-full p-2 text-neutral-400 transition hover:bg-white/10 hover:text-white" do %>
      <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6Z"/>
      </svg>
    <% end %>

    <%= link_to likes_path, "aria-label": "Liked Songs",
                class: "rounded-full p-2 text-neutral-400 transition hover:bg-white/10 hover:text-white" do %>
      <svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 14S1.5 9.7 1.5 5.6A3.6 3.6 0 0 1 8 3.5a3.6 3.6 0 0 1 6.5 2.1C14.5 9.7 8 14 8 14Z"/>
      </svg>
    <% end %>

    <%= button_to session_path, { method: :delete, "aria-label": "Switch profile",
                                  class: "cursor-pointer rounded p-0.5" } do %>
      <span aria-hidden="true"
            class="flex size-8 items-center justify-center rounded text-xs font-bold text-black <%= avatar_colour(Current.profile) %>">
        <%= avatar_initial(Current.profile) %>
      </span>
    <% end %>
  </div>

  <%= form_with url: search_path, method: :get, class: "min-w-0 flex-1", data: { turbo_action: "advance" } do |form| %>
    <%= form.search_field :q, value: params[:q], placeholder: "What do you want to listen to?",
                          autocomplete: "off", aria: { label: "Search" },
                          class: "w-full max-w-md rounded-full border border-white/10 bg-neutral-800 px-5 py-2.5
                                  text-sm text-white placeholder:text-neutral-500
                                  focus:border-emerald-500 focus:outline-none" %>
  <% end %>
</div>
