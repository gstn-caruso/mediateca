<%# Where you stand on an artist, and the two ways to change it.

    A native <details> menu, the same one the + on a song opens: no JavaScript,
    and Escape closes it because the browser says so.

    Each item offers the opposite of what is true, because a menu is for changing
    a thing, not for reading it — what is true is written on the artist's own
    page, where there is room to say it. %>
<% item = "w-full cursor-pointer truncate rounded px-3 py-2 text-left text-sm text-neutral-300 transition hover:bg-white/10 hover:text-white" %>

<span id="<%= dom_id(artist, :standing) %>" class="shrink-0">
  <details class="relative">
    <summary aria-label="What to do about <%= artist.name %>"
             class="flex size-9 cursor-pointer list-none items-center justify-center rounded-full bg-black/40
                    text-lg leading-none text-neutral-300 ring-1 ring-inset ring-white/10 transition
                    hover:bg-white/10 hover:text-white active:scale-90">…</summary>

    <div class="absolute right-0 z-20 mt-1 w-60 rounded-xl menu-panel p-1">
      <% if Current.profile.hides?(artist) %>
        <%= button_to "Show in the library", artist_standing_path(artist, standing: :hidden),
                      method: :delete, class: item %>
      <% else %>
        <%= button_to "Hide from the library", artist_standing_path(artist, standing: :hidden), class: item %>
      <% end %>

      <% if Current.profile.highlights?(artist) %>
        <%= button_to "Stop highlighting", artist_standing_path(artist, standing: :highlighted),
                      method: :delete, class: item %>
      <% else %>
        <%= button_to "Highlight in what's next", artist_standing_path(artist, standing: :highlighted), class: item %>
      <% end %>
    </div>
  </details>
</span>
