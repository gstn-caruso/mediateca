<%# Spotify puts Home and the search box in a bar of their own, above everything
    else, because they are what you reach for without looking. The sidebar is
    desktop-only, so on a phone this bar also carries the hearts and the way out
    of a profile. %>
<header id="topbar" class="flex shrink-0 items-center gap-2 rounded-lg bg-neutral-900 px-3 py-2 sm:gap-3">
  <%= link_to root_path, class: "hidden shrink-0 items-center gap-2 px-2 text-neutral-200 transition hover:text-white sm:flex" do %>
    <svg class="size-6 text-emerald-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6Z"/>
    </svg>
    <span class="text-lg font-bold tracking-tight">Mediateca</span>
  <% end %>

  <%= link_to root_path, "aria-label": "Home",
              class: "shrink-0 rounded-full bg-neutral-800 p-2.5 text-neutral-300 transition hover:scale-105 hover:text-white" do %>
    <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.5 3.247a1 1 0 0 0-1 0L4 7.577V20h4.5v-6a1 1 0 0 1 1-1h5a1 1 0 0 1 1 1v6H20V7.577l-7.5-4.33Z"/>
    </svg>
  <% end %>

  <%= link_to likes_path, "aria-label": "Liked Songs",
              class: "shrink-0 rounded-full bg-neutral-800 p-2.5 text-neutral-300 transition hover:text-white md:hidden" do %>
    <svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M8 14S1.5 9.7 1.5 5.6A3.6 3.6 0 0 1 8 3.5a3.6 3.6 0 0 1 6.5 2.1C14.5 9.7 8 14 8 14Z"/>
    </svg>
  <% end %>

  <%= form_with url: search_path, method: :get, class: "min-w-0 flex-1", data: { turbo_action: "advance" } do |form| %>
    <%= form.search_field :q, value: params[:q], placeholder: "What do you want to listen to?",
                          autocomplete: "off", aria: { label: "Search" },
                          class: "w-full max-w-xl rounded-full border border-white/10 bg-neutral-800 px-5 py-2.5
                                  text-sm text-white placeholder:text-neutral-500
                                  focus:border-emerald-500 focus:outline-none" %>
  <% end %>

  <div class="ml-auto flex shrink-0 items-center gap-2">
    <span aria-hidden="true"
          class="flex size-9 items-center justify-center rounded-full text-sm font-bold text-black <%= avatar_colour(Current.profile) %>">
      <%= avatar_initial(Current.profile) %>
    </span>
    <span class="hidden max-w-32 truncate text-sm font-medium text-neutral-100 sm:block"><%= Current.profile.name %></span>
    <%= button_to "Switch profile", session_path, method: :delete,
                  class: "cursor-pointer rounded-full px-3 py-1 text-xs font-semibold text-neutral-400 transition hover:bg-white/10 hover:text-white" %>
  </div>
</header>
