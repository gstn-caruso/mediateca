<%# Spotify puts Home and the search box in a bar of their own, above everything
    else, because they are what you reach for without looking. The sidebar is
    desktop-only, so on a phone this bar also carries the hearts and the way out
    of a profile. %>
<%# relative z-30: the glass panels around it are backdrop-filter layers of their
    own and would otherwise paint over the profile menu that drops out of here. %>
<header id="topbar" class="relative z-30 flex shrink-0 items-center gap-2 rounded-2xl glass px-3 py-2 sm:gap-3">
  <%# Folds the library rail away; it comes back through this same button. %>
  <button type="button" data-action="sidebar#toggle" aria-label="Library"
          class="hidden shrink-0 rounded-full bg-white/10 p-2.5 text-neutral-200 transition hover:bg-white/15 hover:text-white md:block">
    <svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M3.5 2A1.5 1.5 0 0 0 2 3.5v9A1.5 1.5 0 0 0 3.5 14h9a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 12.5 2h-9Zm0 1.5H6v9H3.5v-9Zm4 0h5v9h-5v-9Z"/>
    </svg>
  </button>

  <%= link_to root_path, "aria-label": "Home",
              class: "shrink-0 rounded-full bg-white/10 p-2.5 text-neutral-200 transition hover:scale-105 hover:bg-white/15 hover:text-white" do %>
    <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.5 3.247a1 1 0 0 0-1 0L4 7.577V20h4.5v-6a1 1 0 0 1 1-1h5a1 1 0 0 1 1 1v6H20V7.577l-7.5-4.33Z"/>
    </svg>
  <% end %>

  <%= link_to likes_path, "aria-label": "Liked Songs",
              class: "shrink-0 rounded-full bg-white/10 p-2.5 text-neutral-200 transition hover:bg-white/15 hover:text-white md:hidden" do %>
    <svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M8 14S1.5 9.7 1.5 5.6A3.6 3.6 0 0 1 8 3.5a3.6 3.6 0 0 1 6.5 2.1C14.5 9.7 8 14 8 14Z"/>
    </svg>
  <% end %>

  <%= form_with url: search_path, method: :get, class: "min-w-0 flex-1", data: { turbo_action: "advance" } do |form| %>
    <%= form.search_field :q, value: params[:q], placeholder: "What do you want to listen to?",
                          autocomplete: "off", aria: { label: "Search" },
                          class: "w-full max-w-xl rounded-full border border-white/10 bg-white/10 px-5 py-2.5
                                  text-sm text-white placeholder:text-neutral-400
                                  focus:border-accent focus:bg-white/15 focus:outline-none" %>
  <% end %>

  <%# Opens the picture. Milkdrop, drawn from the sound itself — so the icon is
      the sound itself, the bars the old players danced while a song ran.

      Unlike the microphone beside it, this is never dead: a song with no words
      has nothing to show, but there is no such thing as a song with no sound. %>
  <button type="button" data-action="player#toggleVisualizer" data-player-target="visualizerToggle"
          aria-label="Visualizer" aria-expanded="false"
          class="shrink-0 rounded-full bg-white/10 p-2.5 text-neutral-300 transition hover:bg-white/15 hover:text-white active:scale-90
                 aria-expanded:text-accent">
    <svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <rect x="1.5" y="7.5" width="2" height="6" rx="1"/>
      <rect x="5.2" y="2.5" width="2" height="11" rx="1"/>
      <rect x="8.8" y="5.5" width="2" height="8" rx="1"/>
      <rect x="12.5" y="9" width="2" height="4.5" rx="1"/>
    </svg>
  </button>

  <%# Opens the words, beside the queue and before it: a microphone, because what
      it opens is a karaoke — the line being sung lights up as the song runs.

      A song nobody wrote the words for has nothing for it to open, and then it
      goes dead rather than opening onto an empty rail. The player says when: it
      is the one that knows what is playing. %>
  <button type="button" data-action="player#toggleLyrics" data-player-target="lyricsToggle"
          aria-label="Lyrics" aria-expanded="false"
          class="shrink-0 rounded-full bg-white/10 p-2.5 text-neutral-300 transition hover:bg-white/15 hover:text-white active:scale-90
                 aria-expanded:text-accent
                 disabled:cursor-default disabled:text-neutral-700 disabled:hover:bg-white/10 disabled:hover:text-neutral-700 disabled:active:scale-100">
    <svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M8 1a2.5 2.5 0 0 1 2.5 2.5v4a2.5 2.5 0 0 1-5 0v-4A2.5 2.5 0 0 1 8 1Z"/>
      <path d="M4 6.75a.75.75 0 0 1 .75.75v.5a3.25 3.25 0 0 0 6.5 0v-.5a.75.75 0 0 1 1.5 0v.5a4.75 4.75 0 0 1-4 4.69V14h1.75a.75.75 0 0 1 0 1.5h-5a.75.75 0 0 1 0-1.5H7.25v-1.31a4.75 4.75 0 0 1-4-4.69v-.5A.75.75 0 0 1 4 6.75Z"/>
    </svg>
  </button>

  <%# Opens the queue — beside the content on a desktop, over it on a phone. It
      used to be desktop-only, which is why a phone had no queue at all. %>
  <button type="button" data-action="player#toggleQueue" data-player-target="queueToggle"
          aria-label="Playing Next" aria-expanded="false"
          class="shrink-0 rounded-full bg-white/10 p-2.5 text-neutral-300 transition hover:bg-white/15 hover:text-white active:scale-90 aria-expanded:text-accent">
    <svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M15 15H1v-1.5h14V15Zm0-4.5H1V9h14v1.5Zm-14-7A2.5 2.5 0 0 1 3.5 1h9a2.5 2.5 0 0 1 0 5h-9A2.5 2.5 0 0 1 1 3.5Z"/>
    </svg>
  </button>

  <%# A native <details> menu: just the avatar in the bar, the name and the way
      out tucked behind it. No JavaScript, and Escape closes it. %>
  <details class="relative shrink-0">
    <summary aria-label="Profile"
             class="flex size-9 cursor-pointer list-none items-center justify-center rounded-full text-sm font-bold text-black
                    ring-white/0 transition hover:scale-105 [&::-webkit-details-marker]:hidden <%= avatar_colour(Current.profile) %>">
      <%= avatar_initial(Current.profile) %>
    </summary>

    <div class="absolute right-0 z-30 mt-2 w-60 rounded-2xl menu-panel p-1.5">
      <%# The name is the way in. Everything the app knows about somebody lives on
          one page now, and this is the door to it. %>
      <%= link_to profile_path, class: "flex items-center gap-3 rounded-xl px-2.5 py-2 transition hover:bg-white/10" do %>
        <span aria-hidden="true"
              class="flex size-9 shrink-0 items-center justify-center rounded-full text-sm font-bold text-black <%= avatar_colour(Current.profile) %>">
          <%= avatar_initial(Current.profile) %>
        </span>
        <span class="min-w-0">
          <span class="block truncate text-sm font-semibold text-white"><%= Current.profile.name %></span>
          <span class="block text-xs text-neutral-400">Your listening</span>
        </span>
      <% end %>

      <div class="mx-1 my-1 h-px bg-white/10"></div>

      <%# Last.fm, and only if somebody handed this Mediateca an API account.
          Without one there is no Last.fm in the app at all, and a menu item that
          leads nowhere is worse than no menu item.

          Connected, it says who you are over there and links to you over there —
          which Last.fm's terms ask for, and which is the plain courtesy anyway:
          the listening leaves the house, so the house says where it went. %>
      <% if Lastfm.api.configured? %>
        <% if Current.profile.scrobbles? %>
          <%= link_to scrobbler_path,
                      class: "flex items-center gap-3 rounded-xl px-3 py-2 transition hover:bg-white/10" do %>
            <%= render "shared/lastfm_mark" %>
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-medium text-white">Scrobbling</span>
              <span class="block truncate text-xs text-neutral-400"><%= Current.profile.scrobbler.username %></span>
            </span>
          <% end %>
        <% else %>
          <%= link_to connect_scrobbler_path,
                      class: "flex w-full items-center gap-3 rounded-xl px-3 py-2 text-left text-sm font-medium
                              text-neutral-200 transition hover:bg-white/10 hover:text-white" do %>
            <%= render "shared/lastfm_mark" %>
            Connect Last.fm
          <% end %>
        <% end %>

        <%# Last.fm's terms ask for it by name, and it is the plain courtesy: the
            scrobbles are theirs to keep, so their name is on the door. %>
        <%= link_to "Powered by AudioScrobbler", "https://www.last.fm", target: "_blank", rel: "noopener",
                    class: "block px-3 pb-1.5 pt-0.5 text-[10px] text-neutral-500 transition hover:text-neutral-300" %>
      <% end %>

      <%# Spotify, and only for what it can actually give: the songs you hearted
          there and the lists you made. Not your listening — it has no endpoint for
          a history, and never has had. That is what Last.fm is for. %>
      <% if Spotify.api.signed_in? %>
        <%= link_to Current.profile.spotify? ? spotify_path : connect_spotify_path,
                    class: "flex w-full items-center gap-3 rounded-xl px-3 py-2 text-left text-sm
                            text-neutral-200 transition hover:bg-white/10 hover:text-white" do %>
          <span aria-hidden="true" class="flex size-6 shrink-0 items-center justify-center rounded-md bg-[#1DB954] text-black">
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.586 14.424a.623.623 0 0 1-.857.207c-2.348-1.435-5.304-1.76-8.785-.964a.623.623 0 1 1-.277-1.215c3.809-.871 7.077-.496 9.713 1.115.293.18.386.563.206.857Zm1.223-2.722a.78.78 0 0 1-1.072.257c-2.687-1.652-6.785-2.131-9.965-1.166a.78.78 0 1 1-.452-1.493c3.632-1.102 8.147-.568 11.232 1.33a.78.78 0 0 1 .257 1.072Zm.105-2.835c-3.223-1.914-8.54-2.09-11.617-1.156a.935.935 0 1 1-.543-1.79c3.532-1.072 9.404-.865 13.115 1.338a.935.935 0 1 1-.955 1.608Z"/>
            </svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="block font-medium"><%= Current.profile.spotify? ? "Spotify" : "Connect Spotify" %></span>
            <% if Current.profile.spotify? %>
              <span class="block truncate text-xs text-neutral-400"><%= Current.profile.spotify_account.username %></span>
            <% end %>
          </span>
        <% end %>
      <% end %>

      <% if Lastfm.api.configured? || Spotify.api.signed_in? %>
        <div class="mx-1 my-1 h-px bg-white/10"></div>
      <% end %>

      <%# The last option, lit up: leaving a profile is the deliberate exit. %>
      <%= button_to session_path, method: :delete,
                    class: "flex w-full cursor-pointer items-center gap-2 rounded-xl bg-accent/12 px-3 py-2 text-left text-sm font-semibold
                            text-accent ring-1 ring-inset ring-accent/25 transition hover:bg-accent/20" do %>
        <svg class="size-4 shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M6 2.75A.75.75 0 0 1 6.75 2H12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6.75a.75.75 0 0 1 0-1.5H12a.5.5 0 0 0 .5-.5V4a.5.5 0 0 0-.5-.5H6.75A.75.75 0 0 1 6 2.75Z"/>
          <path d="M8.28 5.22a.75.75 0 0 0-1.06 1.06l.97.97H2.75a.75.75 0 0 0 0 1.5h5.44l-.97.97a.75.75 0 1 0 1.06 1.06l2.25-2.25a.75.75 0 0 0 0-1.06L8.28 5.22Z"/>
        </svg>
        Switch profile
      <% end %>
    </div>
  </details>
</header>
