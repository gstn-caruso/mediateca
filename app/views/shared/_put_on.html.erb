<%# The two ways there are to put something on: in the order it was meant to be
    heard, or in no order at all.

    What pressing each one does is the caller's business, because it is not the
    same everywhere. On a record's own page the songs are already on the screen,
    and the queue is simply the rows; on an artist's page there is no tracklist to
    queue from, so the button carries the address where the songs can be had. Two
    mechanisms, one pair of buttons — the difference is real and it is in the data,
    not in the look of the thing you press. %>
<button type="button" <%= tag.attributes(data: play) %>
        aria-label="Play <%= label %>"
        class="inline-flex items-center gap-2 rounded-full bg-accent gel px-7 py-3 text-sm font-semibold text-on-accent transition hover:scale-105 hover:bg-accent-bright">
  <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
    <path d="M3 1.713a.7.7 0 0 1 1.05-.607l10.89 6.288a.7.7 0 0 1 0 1.212L4.05 14.894A.7.7 0 0 1 3 14.288V1.713Z"/>
  </svg>
  Play
</button>

<button type="button" <%= tag.attributes(data: shuffle) %>
        aria-label="Shuffle <%= label %>"
        class="inline-flex items-center gap-2 rounded-full bg-white/10 px-6 py-3 text-sm font-semibold text-white ring-1 ring-inset ring-white/15 transition hover:scale-105 hover:bg-white/15">
  <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
    <path d="M13.151.922a.75.75 0 1 0-1.06 1.06L13.109 3H11.16a3.75 3.75 0 0 0-2.873 1.34l-6.173 7.356A2.25 2.25 0 0 1 .39 12.5H0V14h.391a3.75 3.75 0 0 0 2.873-1.34l6.173-7.356a2.25 2.25 0 0 1 1.724-.804h1.947l-1.017 1.018a.75.75 0 0 0 1.06 1.06L15.98 3.75 13.15.922ZM.391 3.5H0V2h.391c1.109 0 2.16.49 2.873 1.34L4.89 5.277l-.979 1.167-1.796-2.14A2.25 2.25 0 0 0 .39 3.5Z"/>
    <path d="m7.5 10.723.98-1.167.957 1.14a2.25 2.25 0 0 0 1.724.804h1.947l-1.017-1.018a.75.75 0 1 1 1.06-1.06l2.829 2.828-2.829 2.828a.75.75 0 1 1-1.06-1.06L13.109 13H11.16a3.75 3.75 0 0 1-2.873-1.34l-.787-.938Z"/>
  </svg>
  Shuffle
</button>
