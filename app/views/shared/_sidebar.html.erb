<nav class="hidden w-72 shrink-0 flex-col gap-2 md:flex">
  <div class="rounded-lg bg-neutral-900 px-5 py-4">
    <%= link_to root_path, class: "flex items-center gap-2 text-neutral-200 transition hover:text-white" do %>
      <svg class="size-6 text-emerald-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6Z"/>
      </svg>
      <span class="text-lg font-bold tracking-tight">Mediateca</span>
    <% end %>
  </div>

  <div class="flex items-center gap-3 rounded-lg bg-neutral-900 px-4 py-3">
    <span aria-hidden="true"
          class="flex size-9 shrink-0 items-center justify-center rounded text-sm font-bold text-black <%= avatar_colour(Current.profile) %>">
      <%= avatar_initial(Current.profile) %>
    </span>
    <span class="min-w-0 flex-1 truncate text-sm font-medium text-neutral-100"><%= Current.profile.name %></span>
    <%= button_to "Switch profile", session_path, method: :delete,
                  class: "shrink-0 cursor-pointer rounded-full px-3 py-1 text-xs font-semibold text-neutral-400 transition hover:bg-white/10 hover:text-white" %>
  </div>

  <div class="flex min-h-0 flex-1 flex-col rounded-lg bg-neutral-900">
    <h2 class="px-5 py-4 text-sm font-semibold text-neutral-400">Your Library</h2>

    <ul class="min-h-0 flex-1 space-y-1 overflow-y-auto px-2 pb-3">
      <% library_artists.each do |artist| %>
        <li>
          <%= link_to artist_path(artist),
                      class: "flex items-center gap-3 rounded-md p-2 transition hover:bg-white/10 #{"bg-white/10" if current_page?(artist_path(artist))}" do %>
            <div class="size-11 shrink-0 overflow-hidden rounded-full bg-neutral-800">
              <% if (album = artist.albums.first) %>
                <%= image_tag cover_album_path(album), alt: "", loading: "lazy", class: "size-full object-cover" %>
              <% end %>
            </div>
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-neutral-100"><%= artist.name %></p>
              <p class="truncate text-xs text-neutral-400">
                <%= pluralize(artist.albums.size, "album") %>
              </p>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="shrink-0 rounded-lg bg-neutral-900 px-2 py-3">
    <h2 class="px-3 pb-1 text-sm font-semibold text-neutral-400">Playlists</h2>

    <ul class="max-h-48 space-y-0.5 overflow-y-auto">
      <% playlists.each do |playlist| %>
        <li>
          <%= link_to playlist.name, playlist,
                      class: "block truncate rounded px-3 py-1.5 text-sm text-neutral-300 transition hover:bg-white/10 hover:text-white #{"bg-white/10 text-white" if current_page?(playlist)}" %>
        </li>
      <% end %>
    </ul>

    <%= form_with model: Playlist.new, class: "mt-2 flex gap-1 px-1" do |form| %>
      <%= form.text_field :name, placeholder: "New playlist", required: true, autocomplete: "off",
                          "aria-label": "New playlist",
                          class: "min-w-0 flex-1 rounded border border-white/10 bg-neutral-800 px-2 py-1.5 text-sm text-white placeholder:text-neutral-500 focus:border-emerald-500 focus:outline-none" %>
      <%= form.submit "Create",
                      class: "shrink-0 cursor-pointer rounded bg-white/10 px-2.5 py-1.5 text-xs font-semibold text-neutral-200 transition hover:bg-white/20" %>
    <% end %>
  </div>
</nav>
