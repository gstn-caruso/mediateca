<%# A two-row mini-player: the art, the now-playing and the full transport on
    top; a long scrubber underneath that runs the whole width, times on both
    ends, passing beneath the buttons. Shuffle and repeat are the two small
    toggles kept together at the end; a small badge names the file's fidelity. %>
<div class="flex w-[21rem] flex-col gap-2 px-3 py-2.5 sm:w-[26rem]">
  <div class="flex items-center gap-3">
    <img data-player-target="cover" alt=""
         class="hidden size-10 shrink-0 rounded object-cover shadow-lg ring-1 ring-white/10">

    <div class="min-w-0 flex-1">
      <%# After browsing through half the library, the title is the way back.
          It scrolls like a marquee when it's too long to sit still. %>
      <a data-player-target="title" href="#" hidden
         class="marquee block text-[13px] font-medium leading-tight text-neutral-100 hover:underline">
        <span data-player-target="titleText" class="marquee__inner"></span>
      </a>
      <p data-player-target="idle" class="truncate text-[13px] font-medium leading-tight text-neutral-400">Nothing playing</p>

      <div class="mt-0.5 flex items-center gap-1.5">
        <p data-player-target="subtitle" class="marquee min-w-0 flex-1 text-[11px] leading-tight text-neutral-400">
          <span data-player-target="subtitleText" class="marquee__inner"></span>
        </p>
        <%# What the file is, and how good: FLAC · 16/44.1. The full detail —
            bitrate and all — waits in the tooltip. %>
        <span data-player-target="quality" hidden
              class="shrink-0 rounded bg-white/10 px-1.5 py-px text-[9px] font-semibold uppercase tracking-wide text-neutral-300 ring-1 ring-inset ring-white/10"></span>
      </div>

      <%# The end is said out loud: nothing queued after this one. %>
      <p data-player-target="tail" hidden
         class="mt-0.5 flex items-center gap-1 truncate text-[11px] font-semibold text-accent">
        <svg class="size-3 shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 1.5A6.5 6.5 0 1 0 14.5 8 6.507 6.507 0 0 0 8 1.5Zm2.53 4.97a.75.75 0 0 1 0 1.06L8.53 9.53a.75.75 0 0 1-1.06 0L6 8.06a.75.75 0 1 1 1.06-1.06l.94.94 1.47-1.47a.75.75 0 0 1 1.06 0Z"/>
        </svg>
        End of playlist
      </p>
    </div>

    <div class="flex shrink-0 items-center gap-3 sm:gap-3.5">
      <%# The transport: skip back, play, skip on. %>
      <div class="flex items-center gap-3 sm:gap-3.5">
        <button type="button" data-action="player#previous" aria-label="Previous"
                class="hidden text-neutral-300 transition hover:text-white sm:block">
          <svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M3.3 1a.7.7 0 0 1 .7.7v5.15l9.95-5.744a.7.7 0 0 1 1.05.606v12.575a.7.7 0 0 1-1.05.607L4 9.149V14.3a.7.7 0 0 1-.7.7H1.7a.7.7 0 0 1-.7-.7V1.7a.7.7 0 0 1 .7-.7h1.6Z"/>
          </svg>
        </button>

        <button type="button" data-action="player#toggle" aria-label="Play or pause"
                class="flex items-center justify-center text-white transition hover:scale-105">
          <svg data-player-target="playIcon" class="size-7 translate-x-px" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M3 1.713a.7.7 0 0 1 1.05-.607l10.89 6.288a.7.7 0 0 1 0 1.212L4.05 14.894A.7.7 0 0 1 3 14.288V1.713Z"/>
          </svg>
          <svg data-player-target="pauseIcon" class="hidden size-7" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M2.7 1a.7.7 0 0 0-.7.7v12.6a.7.7 0 0 0 .7.7h2.6a.7.7 0 0 0 .7-.7V1.7a.7.7 0 0 0-.7-.7H2.7Zm8 0a.7.7 0 0 0-.7.7v12.6a.7.7 0 0 0 .7.7h2.6a.7.7 0 0 0 .7-.7V1.7a.7.7 0 0 0-.7-.7h-2.6Z"/>
          </svg>
        </button>

        <button type="button" data-action="player#next" data-player-target="next" aria-label="Next"
                class="text-neutral-300 transition hover:text-white disabled:cursor-default disabled:text-neutral-700 disabled:hover:text-neutral-700">
          <svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M12.7 1a.7.7 0 0 0-.7.7v5.15L2.05 1.106A.7.7 0 0 0 1 1.712v12.575a.7.7 0 0 0 1.05.607L12 9.149V14.3a.7.7 0 0 0 .7.7h1.6a.7.7 0 0 0 .7-.7V1.7a.7.7 0 0 0-.7-.7h-1.6Z"/>
          </svg>
        </button>
      </div>

      <%# The two small toggles, kept together at the end: shuffle redeals the
          order under whatever's playing; repeat cycles off → all → one, the "1"
          surfacing only in repeat-one. Both light up when on. %>
      <div class="flex items-center gap-2">
        <button type="button" data-action="player#toggleShuffle" data-player-target="shuffle"
                aria-label="Shuffle" aria-pressed="false"
                class="text-neutral-500 transition hover:text-white aria-pressed:text-accent">
          <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M13.151.922a.75.75 0 1 0-1.06 1.06L13.109 3H11.16a3.75 3.75 0 0 0-2.873 1.34l-6.173 7.356A2.25 2.25 0 0 1 .39 12.5H0V14h.391a3.75 3.75 0 0 0 2.873-1.34l6.173-7.356a2.25 2.25 0 0 1 1.724-.804h1.947l-1.017 1.018a.75.75 0 0 0 1.06 1.06L15.98 3.75 13.15.922ZM.391 3.5H0V2h.391c1.109 0 2.16.49 2.873 1.34L4.89 5.277l-.979 1.167-1.796-2.14A2.25 2.25 0 0 0 .39 3.5Z"/>
            <path d="m7.5 10.723.98-1.167.957 1.14a2.25 2.25 0 0 0 1.724.804h1.947l-1.017-1.018a.75.75 0 1 1 1.06-1.06l2.829 2.828-2.829 2.828a.75.75 0 1 1-1.06-1.06L13.109 13H11.16a3.75 3.75 0 0 1-2.873-1.34l-.787-.938Z"/>
          </svg>
        </button>

        <button type="button" data-action="player#cycleRepeat" data-player-target="repeat"
                aria-label="Repeat" aria-pressed="false"
                class="relative text-neutral-500 transition hover:text-white aria-pressed:text-accent">
          <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M0 4.75A3.75 3.75 0 0 1 3.75 1h8.5A3.75 3.75 0 0 1 16 4.75v5a3.75 3.75 0 0 1-3.75 3.75H9.81l1.018 1.018a.75.75 0 1 1-1.06 1.06L6.939 12.75l2.829-2.828a.75.75 0 1 1 1.06 1.06L9.811 12h2.439a2.25 2.25 0 0 0 2.25-2.25v-5a2.25 2.25 0 0 0-2.25-2.25h-8.5A2.25 2.25 0 0 0 1.5 4.75v5A2.25 2.25 0 0 0 3.75 12H5v1.5H3.75A3.75 3.75 0 0 1 0 9.75v-5Z"/>
          </svg>
          <span data-player-target="repeatOne" hidden
                class="absolute -right-1.5 -top-1.5 flex size-3 items-center justify-center rounded-full bg-accent text-[7px] font-bold leading-none text-white">1</span>
        </button>
      </div>
    </div>
  </div>

  <%# The scrubber runs the whole width, its times on either end, sliding on
      beneath the buttons above it. %>
  <div class="flex items-center gap-2">
    <span data-player-target="elapsed" class="min-w-9 shrink-0 text-right text-[10px] tabular-nums text-neutral-500">0:00</span>
    <input type="range" min="0" max="1000" value="0" step="1"
           data-player-target="progress" data-action="input->player#scrub" aria-label="Progress"
           class="w-full cursor-pointer appearance-none rounded-full bg-white/20">
    <span data-player-target="duration" class="min-w-9 shrink-0 text-[10px] tabular-nums text-neutral-500">–:––</span>
  </div>
</div>

<%# preload=metadata asks for just the FLAC header: enough to know the
    duration without downloading the 34MB. %>
<audio data-player-target="audio"
       data-action="timeupdate->player#tick loadedmetadata->player#tick play->player#refreshIcons pause->player#refreshIcons ended->player#advance"
       preload="metadata"
       class="hidden"></audio>
